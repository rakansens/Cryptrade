-
-/**
- * Interface for KV operations with type support
- */
-export interface KVOperation {
-  /** Table/namespace to operate on */
-  tableName: TABLE_NAMES;
-  /** Key to read/write */
-  key: string;
-  /** Value to write (for put operations) */
-  value?: any;
