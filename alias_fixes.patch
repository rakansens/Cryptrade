-// After: 型安全なリスナー
-+ import { useTypedEventListener } from '@/hooks/use-typed-ui-event-stream';
-+ 
-+ useTypedEventListener('chart:addDrawing', (payload) => {
-+   // payload は ChartEventPayload<'addDrawing'> 型
