    fileName: 'test.ts',
    lineNumber: 42,
  };
  const sampleErrorDefinition: IErrorDefinition<`${ErrorDomain}`, `${ErrorCategory}`> = {
    id: 'BASE_TEST_001',
    domain: 'AGENT',
    category: 'UNKNOWN',
    details: sampleContext,
  };

