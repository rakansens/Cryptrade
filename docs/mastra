                  id: `e${connectingStepId}-${firstEdgeStep.id}`,
                  source: connectingStepId,
                  target: firstEdgeStep.id,
                  remove: finishedLoopResult?.id === firstEdgeStep.id,
                  ...defaultEdgeOptions,
