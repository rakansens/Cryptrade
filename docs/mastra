          .map(([key, value]) => {
            // Check if key is in camelCase and wrap it in backticks if it is
            const isCamelCase = /^[a-z][a-zA-Z]*$/.test(key) && /[A-Z]/.test(key);
            const quotedKey = isCamelCase ? `\`${key}\`` : key;

