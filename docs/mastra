let role: 'assistant' | 'user' = 'assistant';
export const getRole = () => {
  if (role === 'user') role = 'assistant';
  else role = 'user';
  return role;
};
export const createSampleMessage = (threadId: string, createdAt?: Date) =>
  ({
    id: `msg-${randomUUID()}`,
    role: getRole(),
    type: 'text',
    threadId,
    content: [{ type: 'text', text: 'Hello' }],
    createdAt: createdAt || new Date(),
