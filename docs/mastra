                </TooltipTrigger>
                <TooltipContent>Discard prompt suggestions</TooltipContent>
              </Tooltip>
            </button>

            <button onClick={onSave} disabled={!enhancedPrompt}>
              <Tooltip>
                <TooltipTrigger asChild>
                  <Icon className="hover:bg-surface2 rounded-lg">
