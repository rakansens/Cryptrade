            ...step.step,
            originalId: step.step.id,
            label: step.step.id,
            type: hasGraph ? 'nested-node' : 'default-node',
            id: nodeId,
            stepGraph: stepWflowGraph,
            stepSubscriberGraph: stepWflowSubscriberGraph,
