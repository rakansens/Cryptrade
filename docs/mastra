              },
            }),
          ],
        },
        executing: {
          entry: () => {
            this.logger.debug(`Step ${stepNode.id} executing`, {
              stepId: stepNode.id,
              runId: this.#runId,
            });
          },
          on: {
            SUSPENDED: {
              target: 'suspended',
              actions: [
                assign({
                  steps: ({ context, event }: { context: WorkflowContext; event: WorkflowEvent }) => {
                    return {
                      ...context.steps,
                      [stepNode.id as any]: {
