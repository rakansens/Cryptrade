              content: [
                { type: 'text', text: content },
                {
                  type: 'tool-call',
                  toolCallId: value.toolCallId,
                  toolName: value.toolName,
                  args: value.args,
                },
              ],
            };
            return [...currentConversation, newMessage];
          });
        },
