      const pagedRuns = runs.slice(offset, offset + limit);
      return {
        runs: pagedRuns,
        total: runs.length,
      };
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      this.logger.error('Error in getWorkflowRuns:', { message });
