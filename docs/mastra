    const results = (await this.executeQuery(selectQuery.build())) as Record<string, any>[];
    const threads = results.map(mapRowToStorageThreadType);

    return {
      threads,
      total,
      page,
      perPage,
      hasMore: page * perPage + threads.length < total,
    };
  }

