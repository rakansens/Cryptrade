      }
      acc[key] = { ...value, output };
      return acc;
    },
    {} as Record<string, any>,
  );
  const sanitizedRecord: ExtendedWorkflowWatchResult = {
    ...record,
    sanitizedOutput: record
      ? JSON.stringify(
