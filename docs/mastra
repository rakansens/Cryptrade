      },
    });
    const result = mastra.getMCPServer(serverIdA);
    expect(result).toBeUndefined();
    expect(loggerWarnMock).toHaveBeenCalledWith(
      expect.stringContaining(`Could not determine the latest server for logical ID '${serverIdA}'`),
    );
