{
  "description": "Cryptrade Project Linting and Code Style Rules",
  "summary_ja": "Next.js標準設定+厳格なTypeScript型安全性。環境変数は@/config/envから取得、旧型定義は@/types/marketに統合。最大50行制限の小規模関数推奨",
  "typescript": {
    "compiler_options": {
      "target": "es2020",
      "strict": true,
      "noImplicitAny": true,
      "strictNullChecks": true,
      "strictFunctionTypes": true,
      "strictBindCallApply": true,
      "strictPropertyInitialization": true,
      "noImplicitThis": true,
      "alwaysStrict": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noImplicitReturns": true,
      "noFallthroughCasesInSwitch": true,
      "noUncheckedIndexedAccess": true,
      "noImplicitOverride": true,
      "noPropertyAccessFromIndexSignature": true,
      "exactOptionalPropertyTypes": false,
      "forceConsistentCasingInFileNames": true,
      "allowUnreachableCode": false,
      "allowUnusedLabels": false,
      "useUnknownInCatchVariables": true,
      "verbatimModuleSyntax": false,
      "module": "esnext",
      "moduleResolution": "bundler",
      "jsx": "preserve",
      "esModuleInterop": true,
      "skipLibCheck": true,
      "resolveJsonModule": true,
      "isolatedModules": true
    },
    "path_aliases": {
      "@/*": "./*",
      "@/components/*": "./components/*",
      "@/lib/*": "./lib/*",
      "@/hooks/*": "./hooks/*",
      "@/app/*": "./app/*"
    }
  },
  "eslint": {
    "extends": ["next/core-web-vitals"],
    "restricted_imports": [
      {
        "path": "@/lib/utils/old-logger",
        "message": "旧 logger は削除済み。'@/lib/utils/logger' を使ってください。"
      },
      {
        "path": "@/types/binance",
        "message": "型定義は統一済み。'@/types/market' から z.infer で型を取得してください。"
      },
      {
        "path": "@/types/chart",
        "message": "型定義は統一済み。'@/types/market' から z.infer で型を取得してください。"
      },
      {
        "path": "@/lib/schemas/binance.schema",
        "message": "スキーマは '@/types/market' に統合済み。"
      }
    ],
    "restricted_syntax": {
      "no_direct_process_env": {
        "selector": "MemberExpression[object.name='process'][property.name='env']",
        "message": "環境変数は '@/config/env' から型安全に取得してください。直接 process.env へのアクセスは禁止されています。",
        "exceptions": [
          "**/__tests__/**/*",
          "**/*.test.ts",
          "**/*.test.tsx",
          "**/testing/**/*",
          "config/testing/setupEnvMock.ts",
          "lib/utils/logger.ts",
          "lib/utils/zustand-helpers.ts",
          "lib/ws/compat-shim.ts",
          "lib/ws/migration.ts",
          "lib/utils/client-env.ts"
        ]
      }
    }
  },
  "file_patterns": {
    "test_files": [
      "**/__tests__/**/*",
      "**/*.test.{ts,tsx}",
      "**/*.spec.{ts,tsx}"
    ],
    "excluded_from_coverage": [
      "**/*.d.ts",
      "**/__tests__/**",
      "**/__mocks__/**",
      "**/node_modules/**",
      "**/.next/**",
      "**/coverage/**",
      "**/dist/**",
      "**/build/**",
      "**/*.config.{js,ts}",
      "**/jest.setup.js",
      "**/scripts/**",
      "**/e2e/**",
      "**/*.example.{ts,tsx}",
      "**/migrations/**",
      "**/.stryker-tmp/**"
    ],
    "gitignore": {
      "dependencies": ["/node_modules", "/.pnp", ".pnp.js"],
      "testing": ["/coverage", "/coverage-ws/", "/coverage-api/", "/.jest-cache/"],
      "nextjs": ["/.next/", "/out/", "/build"],
      "env": [".env*.local", ".env"],
      "logs": ["*.log", "/logs/"],
      "temp_files": ["*.tmp", "*.temp", "*~", "*.bak", "*.backup", "*.old"],
      "ide": [".idea/", ".vscode/", "*.swp", "*.swo"],
      "test_artifacts": [
        "*.xml",
        "test-results.json",
        "e2e-test-results/",
        "playwright-report/"
      ],
      "typescript": ["*.tsbuildinfo", "next-env.d.ts"],
      "project_specific": [
        ".mastra/",
        "*.db",
        "*.db-shm",
        "*.db-wal",
        "/docs/api",
        "/Cryptrade-worktree/",
        ".claude/",
        "patches/",
        "scripts/benchmarks/"
      ]
    }
  },
  "naming_conventions": {
    "files": {
      "components": "PascalCase for .tsx files (e.g., ChatPanel.tsx)",
      "hooks": "camelCase starting with 'use' (e.g., use-ai-chat.ts)",
      "utils": "kebab-case (e.g., retry-wrapper.ts)",
      "types": "kebab-case with .types.ts or singular noun (e.g., market.ts)",
      "api_routes": "kebab-case directories with route.ts files",
      "stores": "kebab-case with .store.ts suffix (e.g., chat.store.ts)"
    },
    "code": {
      "interfaces": "PascalCase, often with 'I' prefix avoided",
      "types": "PascalCase (e.g., BinanceKlineData)",
      "schemas": "PascalCase with 'Schema' suffix (e.g., ProcessedKlineSchema)",
      "functions": "camelCase (e.g., cn, useChartData)",
      "constants": "UPPER_SNAKE_CASE or camelCase for objects",
      "react_components": "PascalCase",
      "custom_hooks": "camelCase starting with 'use'"
    }
  },
  "import_export_conventions": {
    "imports": {
      "order": [
        "External packages (react, next, etc.)",
        "Internal aliases (@/lib, @/components, etc.)",
        "Relative imports (./*, ../*, etc.)",
        "Type imports (import type { ... })"
      ],
      "style": "Named imports preferred, default exports for pages and components"
    },
    "exports": {
      "schemas_and_types": "Export both schema and inferred type (z.infer)",
      "barrel_exports": "index.ts files for cleaner imports in some directories",
      "components": "Default export for React components"
    }
  },
  "code_style": {
    "formatting": {
      "framework": "Next.js default (no explicit Prettier config)",
      "indentation": "2 spaces",
      "quotes": "Double quotes for strings, single quotes in JSX props",
      "semicolons": "No semicolons (inferred from code examples)",
      "line_length": "No explicit limit, but code tends to wrap at ~100 chars"
    },
    "patterns": {
      "error_handling": "Custom error classes extending BaseError",
      "type_safety": "Zod schemas for runtime validation + TypeScript types",
      "async_operations": "Consistent use of async/await over .then()",
      "react_patterns": "Functional components with hooks",
      "state_management": "Zustand stores with typed actions"
    }
  },
  "testing": {
    "framework": "Jest with ts-jest",
    "structure": {
      "unit_tests": "tests/unit/**",
      "integration_tests": "tests/integration/**",
      "e2e_tests": "tests/e2e/** (Playwright)",
      "test_helpers": "tests/helpers/**"
    },
    "conventions": {
      "describe_blocks": "Feature or component name",
      "it_blocks": "Should + behavior description",
      "mocking": "MSW for API mocks, manual mocks in __mocks__"
    }
  }
}