{
  "name": "cryptrade",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit --pretty",
    "type-check:dev": "tsc --project tsconfig.dev.json --noEmit --pretty",
    "type-check:watch": "tsc --noEmit --watch",
    "type-check:ci": "tsc --project tsconfig.ci.json --noEmit --pretty",
    "type-check:prod": "tsc --project tsconfig.prod.json --noEmit",
    "type-coverage": "type-coverage --detail --show-relative-path",
    "ci:validate": "npm run lint && npm run type-check:ci && npm run test",
    "ci:full": "npm run lint && npm run type-check:ci && npm run type-coverage && npm run test:coverage",
    "test": "TEST_TYPE=unit jest --config jest.config.unit.js",
    "test:watch": "TEST_TYPE=unit jest --config jest.config.unit.js --watch",
    "test:coverage": "TEST_TYPE=unit jest --config jest.config.unit.js --coverage",
    "test:coverage:open": "TEST_TYPE=unit jest --config jest.config.unit.js --coverage && open coverage/index.html",
    "test:coverage:ci": "TEST_TYPE=unit jest --config jest.config.unit.js --coverage --ci --maxWorkers=2",
    "test:coverage:report": "TEST_TYPE=unit jest --config jest.config.unit.js --coverage --coverageReporters=text-summary",
    "test:api": "TEST_TYPE=unit jest --config jest.config.unit.js tests/unit/api",
    "test:api:watch": "TEST_TYPE=unit jest --config jest.config.unit.js --watch tests/unit/api",
    "test:components": "TEST_TYPE=unit jest --config jest.config.unit.js tests/unit/components",
    "test:components:watch": "TEST_TYPE=unit jest --config jest.config.unit.js --watch tests/unit/components",
    "test:hooks": "TEST_TYPE=unit jest --config jest.config.unit.js tests/unit/hooks",
    "test:hooks:watch": "TEST_TYPE=unit jest --config jest.config.unit.js --watch tests/unit/hooks",
    "generate:api-key": "node scripts/generate-api-key.js",
    "test:lib": "TEST_TYPE=unit jest --config jest.config.unit.js tests/unit/lib",
    "test:lib:watch": "TEST_TYPE=unit jest --config jest.config.unit.js --watch tests/unit/lib",
    "test:store": "TEST_TYPE=unit jest --config jest.config.unit.js tests/unit/store",
    "test:store:watch": "TEST_TYPE=unit jest --config jest.config.unit.js --watch tests/unit/store",
    "test:types": "TEST_TYPE=unit jest --config jest.config.unit.js tests/unit/types",
    "test:types:watch": "TEST_TYPE=unit jest --config jest.config.unit.js --watch tests/unit/types",
    "test:config": "TEST_TYPE=unit jest --config jest.config.unit.js tests/unit/config",
    "test:config:watch": "TEST_TYPE=unit jest --config jest.config.unit.js --watch tests/unit/config",
    "test:analysis": "TEST_TYPE=unit jest --config jest.config.unit.js tests/unit/lib/analysis",
    "test:analysis:watch": "TEST_TYPE=unit jest --config jest.config.unit.js --watch tests/unit/lib/analysis",
    "test:ws": "TEST_TYPE=unit jest --config jest.config.unit.js tests/unit/lib/ws",
    "test:ws:watch": "TEST_TYPE=unit jest --config jest.config.unit.js --watch tests/unit/lib/ws",
    "test:mastra": "TEST_TYPE=unit jest --config jest.config.unit.js tests/unit/lib/mastra",
    "test:mastra:watch": "TEST_TYPE=unit jest --config jest.config.unit.js --watch tests/unit/lib/mastra",
    "test:indicators": "TEST_TYPE=unit jest --config jest.config.unit.js tests/unit/lib/indicators",
    "test:indicators:watch": "TEST_TYPE=unit jest --config jest.config.unit.js --watch tests/unit/lib/indicators",
    "test:utils": "TEST_TYPE=unit jest --config jest.config.unit.js tests/unit/lib/utils",
    "test:utils:watch": "TEST_TYPE=unit jest --config jest.config.unit.js --watch tests/unit/lib/utils",
    "test:chat": "TEST_TYPE=unit jest --config jest.config.unit.js tests/unit/components/chat",
    "test:chat:watch": "TEST_TYPE=unit jest --config jest.config.unit.js --watch tests/unit/components/chat",
    "test:chart": "TEST_TYPE=unit jest --config jest.config.unit.js tests/unit/components/chart",
    "test:chart:watch": "TEST_TYPE=unit jest --config jest.config.unit.js --watch tests/unit/components/chart",
    "test:unit": "TEST_TYPE=unit jest --config jest.config.unit.js",
    "test:unit:watch": "TEST_TYPE=unit jest --config jest.config.unit.js --watch",
    "test:integration": "TEST_TYPE=integration jest --config jest.config.integration.js",
    "test:integration:watch": "TEST_TYPE=integration jest --config jest.config.integration.js --watch",
    "test:integration:orchestrator": "TEST_TYPE=integration jest --config jest.config.integration.js tests/integration/orchestrator",
    "test:integration:proposals": "TEST_TYPE=integration jest --config jest.config.integration.js tests/integration/proposals",
    "test:integration:api": "TEST_TYPE=integration jest --config jest.config.integration.js tests/integration/api",
    "test:e2e": "playwright test",
    "test:e2e:jest": "TEST_TYPE=e2e jest --config jest.config.e2e.js",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "PWDEBUG=1 playwright test",
    "test:e2e:docker": "docker-compose -f docker-compose.test.yml run playwright",
    "test:server": "node test-server.js",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:ci": "TEST_TYPE=unit jest --config jest.config.unit.js --ci --coverage --maxWorkers=2",
    "test:shard": "TEST_TYPE=unit jest --config jest.config.unit.js --shard",
    "test:errors": "TEST_TYPE=unit jest --config jest.config.unit.js tests/unit/lib/errors",
    "test:monitoring": "TEST_TYPE=unit jest --config jest.config.unit.js tests/unit/lib/monitoring",
    "test:api:unit": "TEST_TYPE=unit jest --config jest.config.unit.js tests/unit/api",
    "test:parallel": "TEST_TYPE=unit jest --config jest.config.unit.js --maxWorkers=50%",
    "test:coverage:html": "TEST_TYPE=unit jest --config jest.config.unit.js --coverage --coverageReporters=html",
    "test:coverage:lcov": "TEST_TYPE=unit jest --config jest.config.unit.js --coverage --coverageReporters=lcov",
    "test:changed": "TEST_TYPE=unit jest --config jest.config.unit.js --onlyChanged",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "test:memory-demo": "tsx scripts/test-memory-demo.ts",
    "test:memory-api": "tsx scripts/test-memory-api.ts",
    "test:performance": "TEST_TYPE=unit jest --config jest.config.unit.js tests/performance --testTimeout=60000",
    "benchmark": "tsx tests/performance/benchmark-runner.ts",
    "benchmark:compare": "tsx tests/performance/benchmark-runner.ts --compare",
    "benchmark:baseline": "tsx tests/performance/benchmark-runner.ts --save-baseline",
    "docs:api": "typedoc",
    "docs:check": "tsx scripts/check-typedoc-todos.ts",
    "docs:watch": "typedoc --watch",
    "docs:validate": "typedoc --validation.notDocumented --validation.invalidLink",
    "env:check": "tsx scripts/env-validate.ts",
    "check:env-usage": "tsx scripts/check-env-usage.ts",
    "prebuild": "npm run env:check",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "supabase db seed",
    "db:studio": "prisma studio",
    "db:setup": "npm run db:start && npm run db:push && npm run db:seed",
    "db:generate": "prisma generate",
    "test:validate": "tsx scripts/validate-test-imports.ts",
    "prepare": "husky install"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.22",
    "@mastra/core": "^0.10.5",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@sentry/nextjs": "^9.29.0",
    "@sentry/node": "^9.29.0",
    "@supabase/supabase-js": "^2.50.0",
    "@tensorflow/tfjs": "^4.22.0",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "eventsource": "^4.0.0",
    "framer-motion": "^12.16.0",
    "glob": "^11.0.3",
    "isomorphic-dompurify": "^2.25.0",
    "lightweight-charts": "^4.1.3",
    "lucide-react": "^0.358.0",
    "next": "15.3.3",
    "react": "^18.3.1",
    "react-resizable-panels": "^2.1.3",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^2.2.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.45",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@prisma/client": "^6.9.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "20.6.2",
    "@types/node-fetch": "^2.6.12",
    "@types/react": "18.2.22",
    "@types/react-dom": "18.2.7",
    "autoprefixer": "10.4.15",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.5.0",
    "eslint": "8.49.0",
    "eslint-config-next": "13.5.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "msw": "^2.8.7",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.5",
    "puppeteer": "^24.10.0",
    "tailwindcss": "3.3.3",
    "ts-node": "^10.9.1",
    "typescript": "5.2.2"
  },
  "overrides": {
    "nanoid": "^5.0.0",
    "xml2js": "^0.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
